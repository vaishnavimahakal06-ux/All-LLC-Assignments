# <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

// Helper function to safely read strings and strip trailing newlines
void readString(char *str, int size) {
    fgets(str, size, stdin);
    str[strcspn(str, "\n")] = '\0';
}
include
int main() {
    char str1[100], str2[100], temp[200];
    int choice, result;
    size_t length;

    while (1) {
        printf("\n========== STRING OPERATIONS MENU ==========\n");
        printf("1. Find Length of String\n");
        printf("2. Copy String\n");
        printf("3. Concatenate Strings\n");
        printf("4. Compare Strings\n");
        printf("5. Reverse String\n");
        printf("6. Convert to Upper Case\n");
        printf("7. Convert to Lower Case\n");
        printf("8. Exit\n");
        printf("============================================\n");
        printf("Enter your choice (1-8): ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input! Please enter a number.\n");
            while (getchar() != '\n');
            continue;
        }

        while (getchar() != '\n');

        switch (choice) {         
             case 1:
                printf("\nEnter a string: ");
                readString(str1, sizeof(str1));
                length = strlen(str1);
                printf("Length of the string is: %zu\n", length);
                break;

            case 2:
                printf("\nEnter the source string to copy from: ");
                readString(str1, sizeof(str1));
                strcpy(temp, str1);
                printf("Successfully copied! Target variable contains: \"%s\"\n", temp);
                break;

            case 3:
                printf("\nEnter the first string: ");
                readString(str1, sizeof(str1));
                printf("Enter the second string to append: ");
                readString(str2, sizeof(str2));

                if (strlen(str1) + strlen(str2) < sizeof(str1)) {
                    strcat(str1, str2);
                    printf("Concatenated string: \"%s\"\n", str1);
                } else {
                    printf("Error: Destination buffer is too small!\n");
                }
                break;

            case 4:
                printf("\nEnter first string to compare: ");
                readString(str1, sizeof(str1));
                printf("Enter second string to compare: ");
                readString(str2, sizeof(str2));

                result = strcmp(str1, str2);

                if (result == 0) {
                    printf("Result: Both strings are exactly identical.\n");
                } else if (result > 0) {
                    printf("Result: First string is greater than the second.\n");
                } else {
                    printf("Result: Second string is greater than the first.\n");
                }
                break;

            case 5:
                printf("\nEnter a string to reverse: ");
                readString(str1, sizeof(str1));

                int len = strlen(str1);

                for (int i = 0; i < len / 2; i++) {
                    char t = str1[i];
                    str1[i] = str1[len - 1 - i];
                    str1[len - 1 - i] = t;
                }

                printf("Reversed string: \"%s\"\n", str1);
                break;

            case 6:
                printf("\nEnter a string to convert to upper case: ");
                readString(str1, sizeof(str1));

                for (int i = 0; str1[i] != '\0'; i++) {
                    str1[i] = toupper((unsigned char)str1[i]);
                }

                printf("Upper case string: \"%s\"\n", str1);
                break;

            case 7:
                printf("\nEnter a string to convert to lower case: ");
                readString(str1, sizeof(str1));

                for (int i = 0; str1[i] != '\0'; i++) {
                    str1[i] = tolower((unsigned char)str1[i]);
                }

                printf("Lower case string: \"%s\"\n", str1);
                break;

            case 8:
                printf("\nExiting program. Goodbye!\n");
                exit(0);

            default:
                printf("\nInvalid choice! Please choose an option between 1 and 8.\n");
        }
    }

    return 0;
}
