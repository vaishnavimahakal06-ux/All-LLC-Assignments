#include <stdio.h>

// Define structure
struct Student {
    int roll_no;
    char name[50];
    float marks[3];
    float total;
    float percentage;
    char result[10];
};

int main() {
    int n, i, j;

    printf("Enter the number of students: ");
    scanf("%d", &n);

    struct Student students[n];

    // Accepting student details
    for (i = 0; i < n; i++) {
        printf("\n--- Enter details for student %d ---\n", i + 1);
        printf("Enter Roll Number: ");
        scanf("%d", &students[i].roll_no);

        printf("Enter Name: ");
        scanf(" %[^\n]s", students[i].name); // Reads string with spaces

        students[i].total = 0.0;
        printf("Enter marks for 3 subjects (out of 100):\n");
        for (j = 0; j < 3; j++) {
            printf("Subject %d: ", j + 1);
            scanf("%f", &students[i].marks[j]);
            students[i].total += students[i].marks[j];
        }

        // Calculating percentage
        students[i].percentage = students[i].total / 3.0;

        // Determining Pass/Fail (passing criteria: percentage >= 40%)
        if (students[i].percentage >= 40.0) {
            snprintf(students[i].result, sizeof(students[i].result), "Pass");
        } else {
            snprintf(students[i].result, sizeof(students[i].result), "Fail");
        }
    }

    // Displaying student results in a table
    printf("\n\n==================== STUDENT RESULT SHEET ====================\n");
    printf("%-10s %-20s %-10s %-12s %-10s\n", "Roll No", "Name", "Total", "Percentage", "Result");
    printf("--------------------------------------------------------------\n");

    for (i = 0; i < n; i++) {
        printf("%-10d %-20s %-10.2f %-12.2f %-10s\n",
               students[i].roll_no,
               students[i].name,
               students[i].total,
               students[i].percentage,
               students[i].result);
    }

    printf("==============================================================\n");

    return 0;
}
